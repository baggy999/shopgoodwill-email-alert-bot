# Incoming mailbox containing official ShopGoodwill Personal Shopper emails
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=alerts@example.com
IMAP_PASSWORD=replace_me
IMAP_FOLDER=INBOX
IMAP_SENDER_MATCH=shopgoodwill
IMAP_LOOKBACK_DAYS=14

# Existing SMTP2GO settings can be reused
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_USERNAME=replace_me
SMTP_PASSWORD=replace_me
SMTP_USE_TLS=true
SMTP_USE_SSL=false

ALERT_FROM_EMAIL=alerts@planenews.net
ALERT_TO_EMAIL=admin@planenews.net

SEARCH_TERMS=charm,charms
ALERT_MINUTES_BEFORE=60
POLL_SECONDS=120
AUCTION_TIMEZONE=America/Los_Angeles
SEND_PARSE_FAILURES=false
LOG_LEVEL=INFO
PORT=8080
DATA_DIR=/data
